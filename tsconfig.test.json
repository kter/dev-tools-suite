{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "paths": {
      "@shared/*": ["./tools/shared/*"]
    }
  },
  "include": [
    "tests/unit/**/*.ts",
    "tools/*/utils/**/*.ts",
    "tools/shared/utils/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
